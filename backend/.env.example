# PyChain backend environment.
# Copy to `.env` (gitignored) before running `python main.py`. All values are
# OPTIONAL: without the Supabase keys the backend uses an in-memory store (data
# is lost on restart) — fine for local dev and tests.

# Supabase persistence (sessions + templates). The SERVICE ROLE key bypasses
# RLS — never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowed CORS origins (default: http://localhost:3000,http://localhost:5173).
# CORS_ORIGINS=http://localhost:3000

# File-retention tuning (seconds). Defaults: TTL 604800 (7 days).
# CLEANUP_TTL_SECONDS=604800
# CLEANUP_INTERVAL_SECONDS=3600
