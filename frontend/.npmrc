# ── Supply-chain hardening (added 2026-05-29) ────────────────────────────────
# Context: corporate SOC "NPM Compromise Campaign" alert. This repo audited
# clean, but these settings reduce exposure to the 2025-2026 npm worm campaigns
# (Shai-Hulud 1.0/2.0, "Mini Shai-Hulud"/TeamPCP).

# Block install-time script execution. This neutralizes the PRIMARY infection
# vector of every recent campaign — malicious pre/postinstall (and Mini
# Shai-Hulud's preinstall) scripts that run on `npm install` / `npm ci`.
# Safe here: sharp and unrs-resolver ship prebuilt native binaries as
# optional-dependency packages (@img/sharp-*, @unrs/resolver-binding-*), so no
# legitimate build step is skipped. If you ever add a dep that genuinely needs
# a build step on a platform without a prebuilt, build it explicitly with
# `npm rebuild <pkg>` or temporarily `npm ci --foreground-scripts`.
ignore-scripts=true

# Keep advisory auditing on and surface low+ severity findings.
audit=true
audit-level=low
