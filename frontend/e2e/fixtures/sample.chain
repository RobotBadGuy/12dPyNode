<?xml version="1.0"?>
<xml12d xmlns="http://www.12d.com/schema/xml12d-10.0">
<meta_data></meta_data>
<Chain>
<version>1</version>
<Settings></Settings>
<Commands>
  <Clean_model>
    <Name>Clean model Sample</Name>
    <Active>true</Active>
    <Continue_on_failure>true</Continue_on_failure>
    <Comments></Comments>
    <Model_Name>Sample</Model_Name>
  </Clean_model>
  <Create_view>
    <Name>Create view Sample View</Name>
    <Active>true</Active>
    <Continue_on_failure>true</Continue_on_failure>
    <View>Sample View</View>
    <Top>40</Top>
    <Left>30</Left>
    <Bot>565</Bot>
    <Right>715</Right>
<Comments></Comments>
  </Create_view>
</Commands>
</Chain>
</xml12d>
