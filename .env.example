# PyChain — docker-compose environment (PC-601).
# Copy to `.env` (gitignored). All values are OPTIONAL: with the Supabase keys
# blank, the backend uses an in-memory store (data is lost on restart) — fine for
# a quick local spin-up.

# Supabase persistence (sessions + templates). Get these from your Supabase
# project settings. The SERVICE ROLE key bypasses RLS — never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowed CORS origins for the backend (defaults to localhost:3000).
# CORS_ORIGINS=http://localhost:3000
